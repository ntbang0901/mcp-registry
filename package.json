{
  "name": "mcp-loadout",
  "version": "0.1.0",
  "private": true,
  "description": "Central MCP registry: define MCP servers once, map them to repositories, render client configs.",
  "type": "module",
  "bin": {
    "loadout": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke.mjs",
    "validate": "node dist/cli.js validate --registry .",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run validate && npm run test:smoke && npm run test:e2e"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntbang0901/mcp-registry.git"
  }
}
